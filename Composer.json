{
    "name": "santimode/sierraphp",
    "description": "Light as the Sierra Madre, powerful as it needs to be. Slim-inspired speed + Laravel-inspired DX.",
    "type": "library",
    "keywords": [
        "framework",
        "slim",
        "laravel",
        "micro-framework",
        "sierraphp"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Sierra\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-arch": true
        }
    }
}